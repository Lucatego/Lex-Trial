# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ELEVENLABS_API_KEY: Used by the Node.js script (scripts/elevenlabs-test.ts)
ELEVENLABS_API_KEY="MY_ELEVENLABS_API_KEY"

# VITE_ELEVENLABS_API_KEY: Exposes the ElevenLabs key to the browser (Vite prefix required).
# Used by src/services/elevenLabsTts.ts for in-browser Text-to-Speech.
VITE_ELEVENLABS_API_KEY="MY_ELEVENLABS_API_KEY"

# VITE_ELEVENLABS_VOICE_ID: The ElevenLabs voice ID to use in the browser TTS.
# Default: cjVigY5qzO86Huf0OWal
VITE_ELEVENLABS_VOICE_ID="cjVigY5qzO86Huf0OWal"
